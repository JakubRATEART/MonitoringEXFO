# Optional: API key for protected endpoints
API_KEY=your-secret-key-here

# PDF URL for extraction scheduler
# Set this to your actual PDF URL before running the app
PDF_URL=http://example.com/latest_software.pdf

# Ollama base URL (default: http://localhost:11434)
# Use http://host.docker.internal:11434 when running app in Docker on Mac/Windows
OLLAMA_BASE_URL=http://localhost:11434

# Optional: For future email functionality (if re-enabled)
# AZ_CLIENT_ID=your-client-id
# AZ_TENANT_ID=your-tenant-id
# AZ_CLIENT_SECRET=your-client-secret
# AZ_SENDER=your-email@example.com
# AZ_RECIPIENTS=recipient@example.com
